generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// IDENTITY & ACCESS (NextAuth)
// ==============================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]


  // Custom fields
  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id])
  
  // RBAC
  role         UserRole      @default(USER) // Deprecated, keep for backward compat/migration
  roleId       String?
  userRole     Role?         @relation(fields: [roleId], references: [id])
 
  hashedPassword String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  USER
}

model Role {
  id            String   @id @default(uuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])
  
  name          String   // e.g. "Mali Müşavir", "Depo Sorumlusu"
  description   String?
  isSystem      Boolean  @default(false) // If true, cannot be deleted (e.g. Admin)

  users         User[]
  permissions   RolePermission[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([orgId, name])
}

model Permission {
  id            String   @id @default(uuid())
  key           String   @unique // e.g. "INVOICE_CREATE", "CHEQUE_View"
  description   String?
  group         String   // e.g. "INVOICE", "FINANCE", "STOCK"

  roles         RolePermission[]
}

model RolePermission {
  roleId        String
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  
  permissionId  String
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Organization {
  id        String  @id @default(uuid())
  name      String
  taxNumber String  @unique
  address   String?
  phone     String?
  email     String?

  users    User[]
  invoices Fatura[]
  parties  Cari[]
  journals MuhasebeFisi[]
  accounts HesapPlani[]
  auditLogs AuditLog[]
  banks     Bank[]
  safes     Safe[]
  payments  Payment[]
  products  Product[]
  stockMovements StockMovement[]
  cheques   Cheque[]
  roles     Role[]
  zReports  ZReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==============================
// CORE DOMAIN: INVOICING
// ==============================

model Fatura {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])

  faturaNo String // Gapless sequence managed by app logic
  date     DateTime
  dueDate  DateTime?
  status   FaturaDurumu @default(TASLAK)
  type     FaturaTipi   @default(SATIS)

  cariId String
  cari   Cari   @relation(fields: [cariId], references: [id])

  lines FaturaSatir[]
  payments Payment[]

  // Financials
  subTotal   Decimal @db.Decimal(18, 2)
  taxTotal   Decimal @db.Decimal(18, 2)
  grandTotal Decimal @db.Decimal(18, 2)
  currency   String  @default("TRY")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, faturaNo]) // Unique per organization
}

model FaturaSatir {
  id       String @id @default(uuid())
  faturaId String
  fatura   Fatura @relation(fields: [faturaId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  description String
  quantity    Decimal @db.Decimal(18, 4)
  unitPrice   Decimal @db.Decimal(18, 2)
  taxRate     Int
  total       Decimal @db.Decimal(18, 2)
}

enum FaturaDurumu {
  TASLAK
  ONAYLI // Lawfully valid, ready to send/integrate
  GONDERILDI // Successfully sent to integrator/GIB
  IPTAL
}

enum FaturaTipi {
  SATIS // Sales
  ALIS // Purchase
}

// ==============================
// CORE DOMAIN: PARTY (CARI)
// ==============================

model Cari {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])

  name      String
  taxNumber String?
  type      CariType

  invoices Fatura[]
  payments Payment[]
  cheques  Cheque[] // Added relation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CariType {
  CUSTOMER
  SUPPLIER
  BOTH
}

// ==============================
// CORE DOMAIN: ACCOUNTING
// ==============================

// Muhasebe Fisi (Journal Entry)
model MuhasebeFisi {
  id          String   @id @default(uuid())
  orgId       String
  yevmiyeNo   Int // "Yevmiye Numarası" - Sequential (Gap-less)
  date        DateTime
  description String?

  status FisDurumu @default(TASLAK)

  lines MuhasebeFisiSatir[]

  periodMonth Int
  periodYear  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  // Enforce unique journal number per year per org
  @@unique([orgId, periodYear, yevmiyeNo])
  @@index([orgId, date])
}

model YevmiyeSequence {
  id     String @id @default(uuid())
  orgId  String
  year   Int
  lastNo Int    @default(0)

  // Optimistic concurrency control or just lock row
  updatedAt DateTime @updatedAt

  @@unique([orgId, year])
}

model MuhasebeFisiSatir {
  id        String @id @default(uuid())
  journalId String
  accountId String

  description String?
  debit       Decimal @db.Decimal(18, 2)
  credit      Decimal @db.Decimal(18, 2)

  sequence Int

  journal MuhasebeFisi @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account HesapPlani   @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
}

model HesapPlani {
  id           String        @id @default(uuid())
  orgId        String? // Null means standard/global plan
  organization Organization? @relation(fields: [orgId], references: [id])

  code       String // e.g. "100", "120.01"
  name       String
  parentCode String?

  journalLines MuhasebeFisiSatir[]
  banks        Bank[]
  safes        Safe[]

  @@unique([orgId, code])
}

enum FisDurumu {
  TASLAK
  ONAYLI
}

model MaliDonem {
  id     String       @id @default(uuid())
  orgId  String
  year   Int
  month  Int // 1-12
  status DonemDurumu @default(ACIK)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, year, month])
}

enum DonemDurumu {
  ACIK
  GECICI_KAPALI
  KESIN_KAPALI
}

// ==============================
// INFRASTRUCTURE: OUTBOX
// ==============================

model Outbox {
  id            String    @id @default(uuid())
  aggregateId   String
  aggregateType String // e.g. "Invoice", "Journal"
  eventType     String // e.g. "InvoiceFinalized"
  payload       Json
  occurredAt    DateTime
  processedAt   DateTime? // Null means pending
  error         String?

  @@index([processedAt]) // Worker looks for null processedAt
}

// ==============================
// CROSS-CUTTING: SECURITY & AUDIT
// ==============================

model AuditLog {
  id        String   @id @default(uuid())
  orgId     String
  userId    String?
  action    String
  entityId  String
  entityType String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])

  @@index([orgId, createdAt])
  @@index([entityType, entityId])
}

// ==============================
// CORE DOMAIN: FINANCE (CASH & BANK)
// ==============================

model Bank {
  id            String   @id @default(uuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])

  name          String
  branch        String?
  iban          String?
  currency      String @default("TRY")
  
  accountId     String? // Link to 102.XX in HesapPlani
  account       HesapPlani? @relation(fields: [accountId], references: [id])

  payments      Payment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Safe {
  id            String   @id @default(uuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])

  name          String // e.g. "Merkez TL Kasa"
  currency      String @default("TRY")

  accountId     String? // Link to 100.XX in HesapPlani
  account       HesapPlani? @relation(fields: [accountId], references: [id])

  payments      Payment[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])

  date          DateTime
  amount        Decimal @db.Decimal(18, 2)
  currency      String @default("TRY")
  type          PaymentType // INCOME (Tahsilat) / EXPENSE (Odeme)
  description   String?

  // Relations
  cariId        String?
  cari          Cari? @relation(fields: [cariId], references: [id])

  faturaId      String?
  fatura        Fatura? @relation(fields: [faturaId], references: [id])

  // Source/Target (Either Bank or Safe)
  bankId        String?
  bank          Bank? @relation(fields: [bankId], references: [id])
  
  safeId        String?
  safe          Safe? @relation(fields: [safeId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orgId, date])
  @@index([cariId])
}

enum PaymentType {
  TAHSILAT // Collection (Inbound)
  ODEME    // Payment (Outbound)
}

// ==============================
// CORE DOMAIN: STOCK
// ==============================

model Product {
  id            String   @id @default(uuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])

  name          String
  code          String // SKU / Barcode - Unique per Org
  type          ProductType @default(GOODS)
  
  vatRate       Int     @default(20)
  unit          String  @default("Adet")
  
  buyPrice      Decimal @db.Decimal(18, 2) @default(0)
  sellPrice     Decimal @db.Decimal(18, 2) @default(0)
  currency      String  @default("TRY")

  stockQuantity Decimal @db.Decimal(18, 4) @default(0)

  movements     StockMovement[]
  invoiceLines  FaturaSatir[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([orgId, code])
}

enum ProductType {
  GOODS   // Mal
  SERVICE // Hizmet
}

model StockMovement {
  id            String   @id @default(uuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])

  productId     String
  product       Product @relation(fields: [productId], references: [id])

  quantity      Decimal @db.Decimal(18, 4)
  type          StockMovementType
  
  date          DateTime
  
  refId         String? // Invoice ID
  refType       String? // "INVOICE", "ADJUSTMENT"

  createdAt     DateTime @default(now())
  
  @@index([orgId, productId])
  @@index([orgId, date])
}

enum StockMovementType {
  IN
  OUT
}

// ==============================
// CORE DOMAIN: FINANCE (CHEQUE/PROMISSORY)
// ==============================

model Cheque {
  id            String   @id @default(uuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])

  // Instrument Details
  chequeNo      String
  bankName      String?
  branchName    String?
  accountNo     String?
  drawer        String?  // Keşideci (Name on the cheque)
  
  amount        Decimal @db.Decimal(18, 2)
  currency      String  @default("TRY")
  
  issueDate     DateTime // Keşide Tarihi
  dueDate       DateTime // Vade Tarihi

  type          ChequeType   @default(GELEN)
  instrument    InstrumentType @default(CEK) // Added field
  status        ChequeStatus @default(PORTFOY)

  // Relations
  cariId        String?
  cari          Cari? @relation(fields: [cariId], references: [id])

  // Tracking
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orgId, status])
  @@index([orgId, dueDate])
}

enum ChequeType {
  GELEN // Müşteri Evrağı (Portföy)
  GIDEN // Kendi Evrağımız (Borç)
}

enum InstrumentType {
  CEK
  SENET
}

enum ChequeStatus {
  PORTFOY      // Elde / Portföyde
  TAHSIL       // Tahsil Edildi (Bankaya/Kasaya girdi)
  CIRO         // Ciro Edildi (Satıcıya verildi)
  ODENDI       // Ödendi (Bizim çekimiz ise hesaptan düştü)
  KARSILIKSIZ  // Karşılıksız Çıktı
  IADE         // İade Edildi/Alındı
}

// ==============================
// CORE DOMAIN: COMPLIANCE (Z-REPORT)
// ==============================

model ZReport {
  id            String   @id @default(uuid())
  orgId         String
  organization  Organization @relation(fields: [orgId], references: [id])

  date          DateTime // The actual date of the Z-Report (usually yesterday or today)
  
  imageUrl      String?  // URL to stored image
  totalAmount   Decimal? @db.Decimal(18, 2)
  vatTotal      Decimal? @db.Decimal(18, 2)
  
  status        ZReportStatus @default(PENDING)
  
  ocrData       Json?    // Raw OCR result

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([orgId, date]) // Only one Z-Report per day per org
}

enum ZReportStatus {
  PENDING
  PROCESSED
  ERROR
}
